#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"; [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"; done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"; source "$SCRIPT_DIR/libproductharness.sh"
product_harness_require_git; product_harness_require_python; product_harness_load_config
CHANNEL="$(product_harness_channel "${1:-$CHANNEL}")"; old_commit="$COMMIT"
product_harness_clone_or_fetch "$REPO_PATH" "$REPO_URL"; COMMIT="$(product_harness_checkout_channel "$REPO_PATH" "$CHANNEL")"; VERSION="$(product_harness_version "$REPO_PATH")"
while IFS= read -r root_path; do for namespace in "$root_path"/product-discovery-harness*; do [[ -f "$namespace/.product-harness-install-root" ]] && product_harness_link_target "$REPO_PATH" "$namespace" "$CHANNEL"; done; done < <(product_harness_targets)
product_harness_link_commands "$REPO_PATH"
product_harness_save_config "$REPO_PATH" "$REPO_URL" "$CHANNEL" "$COMMIT" "$VERSION"; echo "Updated: $old_commit -> $COMMIT"; echo "Channel: $CHANNEL"; echo "Version: $VERSION"
